APP_NAME=commerce-gateway
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/commerce_gateway

# Comma-separated browser origins allowed to call this API. Defaults to the
# local Next.js dev server (both hostnames a browser may use for it).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required for the AI buyer (POST /api/agent/chat). Leave unset in
# environments that don't need it; the rest of the app works without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Required for payment (POST /api/checkouts/{id}/payment). Test Mode
# credentials from the Razorpay Dashboard (Settings -> API Keys, Test Mode).
# Leave unset in environments that don't need it; the rest of the app works
# without it. Never commit real values here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
