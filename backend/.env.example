APP_NAME=commerce-gateway
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/commerce_gateway

# Required for the AI buyer (POST /api/agent/chat). Leave unset in
# environments that don't need it; the rest of the app works without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
